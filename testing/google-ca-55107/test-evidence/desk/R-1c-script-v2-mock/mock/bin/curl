#!/bin/bash
# Fake curl for the mock run: serves canned JSON by URL, logs every call.
url=""; method=GET; data=""
while [ $# -gt 0 ]; do case "$1" in -X) method=$2; shift;; --data|--data-urlencode) data="$data $2"; shift;; -H) shift;; -fsS|-sS) ;; *) url=$1;; esac; shift; done
case "$url" in https://oauth2.googleapis.com/token) data=" (JWT assertion omitted)";; esac
echo "$method $url${data}" >> "$MOCK/calls.log"
if [ "$method" = PATCH ]; then echo '{"done":true}'; exit 0; fi
case "$url" in
  https://oauth2.googleapis.com/token)
    if [ -n "${MOCK_TOKEN_ERROR:-}" ]; then echo '{"error":"unauthorized_client","error_description":"Client is unauthorized to retrieve access tokens using this method, or client not authorized for any of the scopes requested."}'
    else echo '{"access_token":"mock-token","expires_in":600,"token_type":"Bearer"}'; fi;;
  *hosts\?per_page=50\&page=0*) cat "${MOCK_HOSTS:-$MOCK/fleet-hosts.json}";;
  *hosts\?per_page=50\&page=*) echo '{"hosts":[]}';;
  *devices\?customer=*pageToken=\&*|*devices\?customer=*pageToken=) cat "$MOCK/g-devices-p1.json";;
  *devices\?customer=*pageToken=P2*) cat "$MOCK/g-devices-p2.json";;
  *deviceUsers\?customer=*) cat "$MOCK/g-users.json";;
  */clientStates/*) f="$MOCK/state-$(echo "$url" | sed -E 's#.*devices/([^/]+)/.*#\1#')"; [ -f "$f" ] && cat "$f" || { echo '{"error":404}' ; exit 22; };;
  *) echo "UNMOCKED $url" >&2; exit 22;;
esac
