<Add>
  <!-- Trust the step-ca root in the device root store so browsers accept the chain -->
  <Item>
    <Target>
      <LocURI>./Device/Vendor/MSFT/RootCATrustedCertificates/Root/FleetLabCARoot/EncodedCertificate</LocURI>
    </Target>
    <Meta>
      <Format xmlns="syncml:metinf">b64</Format>
    </Meta>
    <Data></Data>
  </Item>
</Add>
