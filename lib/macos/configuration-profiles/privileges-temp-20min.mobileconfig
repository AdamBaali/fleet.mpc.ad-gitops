<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  For Macs IT support approved. Admin rights last 20 minutes and can't be renewed, so the
  user has to ask again. A reason is required so the request is logged. Revoking at login
  ends a grant that a restart would otherwise leave in place.
-->
<plist version="1.0">
<dict>
  <key>PayloadContent</key>
  <array>
    <dict>
      <key>PayloadDisplayName</key>
      <string>Privileges 20 minutes</string>
      <key>PayloadIdentifier</key>
      <string>com.fleetdm.lab.privileges.temp20.prefs</string>
      <key>PayloadType</key>
      <string>com.apple.ManagedClient.preferences</string>
      <key>PayloadUUID</key>
      <string>58A3E066-8D7F-4AFB-995E-884283F9F773</string>
      <key>PayloadVersion</key>
      <integer>1</integer>
      <key>PayloadContent</key>
      <dict>
        <key>corp.sap.privileges</key>
        <dict>
          <key>Forced</key>
          <array>
            <dict>
              <key>mcx_preference_settings</key>
              <dict>
                <key>ExpirationInterval</key>
                <integer>20</integer>
                <key>AllowPrivilegeRenewal</key>
                <false/>
                <key>ReasonRequired</key>
                <true/>
                <key>RevokePrivilegesAtLogin</key>
                <true/>
              </dict>
            </dict>
          </array>
        </dict>
      </dict>
    </dict>
  </array>
  <key>PayloadDisplayName</key>
  <string>SAP Privileges 20 minutes</string>
  <key>PayloadIdentifier</key>
  <string>com.fleetdm.lab.privileges.temp20</string>
  <key>PayloadScope</key>
  <string>System</string>
  <key>PayloadType</key>
  <string>Configuration</string>
  <key>PayloadUUID</key>
  <string>877D6158-094E-421D-9C06-7B4A02B00521</string>
  <key>PayloadVersion</key>
  <integer>1</integer>
</dict>
</plist>
